# Optional Android push delivery (Firebase Cloud Messaging).
# Keep the service-account JSON outside the repository and use an absolute path.
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\the-project\firebase-service-account.json

# Password recovery uses the existing browser flow and trusted HTTPS page.
PASSWORD_RESET_FRONTEND_URL=https://your-site.example/pages/password-recovery.html
EMAIL_VERIFICATION_FRONTEND_URL=https://your-site.example/pages/verify-email.html

# Gmail SMTP uses an App Password for the official support mailbox.
# Never put your normal Gmail password here or commit backend/.env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=goalgambitsupport@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM_NAME=GOAL$GAMBIT Support
EMAIL_FROM_ADDRESS=goalgambitsupport@gmail.com

# Administrator Desk access is fail-closed and limited to these two existing
# immutable account IDs. Keep this value aligned with the authorized accounts.
ADMIN_USER_IDS=39,40

# M-Pesa B2C withdrawals use a separate Daraja app from the C2B deposit app.
# Leave disabled until Safaricom has enabled the B2C product and the matching
# production disbursement account/initiator are ready.
MPESA_B2C_ENABLED=false
MPESA_B2C_ENVIRONMENT=production
MPESA_B2C_CONSUMER_KEY=your-b2c-app-consumer-key
MPESA_B2C_CONSUMER_SECRET=your-b2c-app-consumer-secret
MPESA_B2C_SHORTCODE=your-approved-b2c-shortcode
MPESA_B2C_INITIATOR_NAME=your-api-initiator-name
MPESA_B2C_SECURITY_CREDENTIAL=encrypted-credential-from-daraja
# Optional: BusinessPayment (default), SalaryPayment, or PromotionPayment.
MPESA_B2C_COMMAND_ID=BusinessPayment
